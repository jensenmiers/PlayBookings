# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=your_google_calendar_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_calendar_client_secret
CALENDAR_TOKEN_ENCRYPTION_KEY=your_random_calendar_encryption_secret

# Supabase Auth External Google Configuration
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your_google_client_id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your_google_client_secret

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Resend Booking Confirmations
RESEND_API_KEY=your_resend_sending_api_key
BOOKING_EMAIL_FROM=Play Bookings <bookings@notifications.playbookings.com>
BOOKING_EMAIL_REPLY_TO=jensen@playbookings.com
BOOKING_EMAIL_BCC=jensen@playbookings.com,jensenmiers@gmail.com
# Required locally and in Vercel Preview; omit from Production.
BOOKING_EMAIL_OVERRIDE_TO=jensenmiers@gmail.com
NEXT_PUBLIC_APP_URL=https://www.playbookings.com

# PostHog Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_INTERNAL_EMAILS=
NEXT_PUBLIC_POSTHOG_INTERNAL_DOMAINS=
